# --- Banco de dados ---
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres?schema=public"

# --- Servidor ---
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- JWT ---
# Gere segredos fortes e distintos, ex.: `openssl rand -hex 64`
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
JWT_REFRESH_SECRET=troque-este-valor-por-outro-segredo-forte-e-aleatorio
JWT_PREAUTH_SECRET=troque-este-valor-por-mais-um-segredo-forte-e-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h
JWT_PREAUTH_EXPIRES_IN=5m

# --- Cookies de refresh token ---
REFRESH_COOKIE_NAME=nr_refresh_token
COOKIE_SECURE=false

# --- Google OAuth (opcional) ---
# Crie um projeto em https://console.cloud.google.com/
# Em "APIs & Services > Credentials" crie um "OAuth 2.0 Client ID" (tipo: Web application)
# Adicione http://localhost:3000 em "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=
