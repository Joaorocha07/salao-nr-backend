# --- Banco de dados ---
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres?schema=public"

# --- Servidor ---
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- JWT ---
# Gere segredos fortes e distintos, ex.: `openssl rand -hex 64`
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
JWT_REFRESH_SECRET=troque-este-valor-por-outro-segredo-forte-e-aleatorio
JWT_PREAUTH_SECRET=troque-este-valor-por-mais-um-segredo-forte-e-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h
JWT_PREAUTH_EXPIRES_IN=5m

# --- Cookies de refresh token ---
REFRESH_COOKIE_NAME=nr_refresh_token
COOKIE_SECURE=false

# --- Google OAuth (opcional) ---
# Crie um projeto em https://console.cloud.google.com/
# Em "APIs & Services > Credentials" crie um "OAuth 2.0 Client ID" (tipo: Web application)
# Adicione http://localhost:3000 em "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=

# --- WhatsApp ---
# Conectado pelo QR Code na tela WhatsApp do CRM (WhatsApp Web), sem
# configuração aqui. A sessão fica salva no banco, criptografada com uma
# chave derivada do JWT_REFRESH_SECRET: se ele mudar, é preciso ler o QR de
# novo. Rode só UMA instância do backend por banco, senão as duas disputam
# a mesma sessão do WhatsApp. Numa cópia local que aponta pro mesmo banco
# da produção, use WHATSAPP_ENABLED=false.
WHATSAPP_ENABLED=true
# Horários de agendamento (bot e CRM) são comparados com o relógio do
# servidor. Em hospedagens que rodam em UTC, defina o fuso do salão:
TZ=America/Sao_Paulo
