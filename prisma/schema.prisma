generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LeadStatus {
  NOVO_LEAD
  AGENDADO
  FECHADO
  NAO_FECHOU
  ANTIGO
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

// Uma empresa (ex.: as duas unidades do salão). Todo dado de negócio
// pertence a uma Company; um usuário pode ter acesso a mais de uma.
model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      CompanyMembership[]
  leads            Lead[]
  settings         CompanySettings?
  refreshTokens    RefreshToken[]
  whatsappSessions WhatsAppSession[]
  whatsappAuth     WhatsAppAuth[]
  whatsappContacts WhatsAppContact[]

  @@map("companies")
}

// Conta de usuário. O e-mail é único no sistema; o acesso a cada empresa
// é controlado por CompanyMembership. passwordHash é nulo para contas Google.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  googleId     String?  @unique
  imageUrl     String?
  passwordHash String?
  active       Boolean  @default(true)
  // Acesso irrestrito a todas as empresas do sistema, independente de
  // CompanyMembership. Usado só para os donos/operadores do SaaS.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   CompanyMembership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Vínculo do usuário com uma empresa específica + papel dentro dela.
// approvalStatus controla o fluxo de aprovação de auto-cadastro de funcionários.
model CompanyMembership {
  id             String           @id @default(uuid())
  userId         String
  companyId      String
  role           Role             @default(EMPLOYEE)
  active         Boolean          @default(true)
  approvalStatus MembershipStatus @default(ACTIVE)
  // Telas que este membro pode ver no menu. Lista vazia = sem restrição
  // (acesso a tudo). Só é aplicado a funcionários; administradores sempre
  // têm acesso completo, independente deste campo.
  allowedScreens String[]         @default([])
  createdAt      DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

// Refresh tokens de longa duração, com suporte a rotação e revogação.
// Nunca guardamos o token em texto puro, apenas o hash (SHA-256).
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  companyId           String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Lead {
  id              String     @id @default(uuid())
  companyId       String
  name            String
  phone           String
  gender          String?
  birthday        String?
  status          LeadStatus @default(NOVO_LEAD)
  interests       String[]   @default([])
  date            String
  activityDate    String?
  appointmentDate String?
  appointmentTime String?
  appointmentServices String[] @default([])
  // Quando o horário foi marcado, lembretes enviados pelo bot (véspera e
  // pouco antes) e resposta do cliente. Lembrete enviado sem confirmação =
  // alerta amarelo na agenda. Zerados ao reagendar.
  appointmentBookedAt           DateTime?
  appointmentReminderSentAt     DateTime?
  appointmentHourReminderSentAt DateTime?
  appointmentConfirmedAt        DateTime?
  // wa_id do contato no WhatsApp (ex.: 5531999999999). Preenchido quando o
  // cliente conversa com o bot; é o destino das respostas enviadas pelo CRM.
  whatsappId      String?
  // Retorno automático do bot: quando a equipe marcou "Não fechou", última
  // mensagem que o cliente mandou e a última mensagem de retorno enviada
  // (followUpKind: "nao_fechou" ou "inativo").
  notClosedAt         DateTime?
  lastClientMessageAt DateTime?
  followUpSentAt      DateTime?
  followUpKind        String?
  // Primeira mensagem do cliente pelo WhatsApp. Só quem chegou depois do
  // retorno "sem agendamento" existir tem esse campo: é ele que coloca o
  // cliente nesse retorno (7 dias, depois a cada 30, até agendar).
  // followUpCount = quantos retornos "sem agendamento" ele já recebeu.
  firstContactAt      DateTime?
  followUpCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes    LeadNote[]
  messages LeadMessage[]
  history  ServiceRecord[]
  appointmentEvents AppointmentEvent[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, whatsappId])
  @@map("leads")
}

enum AppointmentEventType {
  AGENDADO
  REMARCADO
  CANCELADO
  CONFIRMADO
}

// Histórico do agendamento: o lead só guarda o horário atual, então quem
// cancelou ou remarcou para outro dia fica registrado aqui (resumo do dia na
// agenda). date/time = horário afetado; previous* = horário anterior (remarcação).
model AppointmentEvent {
  id           String               @id @default(uuid())
  companyId    String
  leadId       String
  type         AppointmentEventType
  date         String
  time         String?
  services     String[]             @default([])
  previousDate String?
  previousTime String?
  // "bot" (WhatsApp) ou "crm" (equipe pelo sistema).
  source       String               @default("crm")
  createdAt    DateTime             @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, previousDate])
  @@map("appointment_events")
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  text      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_notes")
}

model LeadMessage {
  id        String   @id @default(uuid())
  leadId    String
  text      String
  own       Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_messages")
}

model ServiceRecord {
  id        String   @id @default(uuid())
  leadId    String
  companyId String
  service   String
  date      String
  time      String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@map("service_records")
}

model CompanySettings {
  companyId            String  @id
  salonName            String  @default("")
  ownerName            String  @default("")
  email                String  @default("")
  greetingMessage      String  @default("")
  autoOldLeadDays      Int     @default(30)
  whatsappConnected    Boolean @default(false)
  captureConversations Boolean @default(true)
  captureName          Boolean @default(true)
  capturePhone         Boolean @default(true)
  autoCreateLead       Boolean @default(true)
  // Catálogo de interesses/serviços que os leads podem selecionar. Cada
  // empresa começa com os serviços padrão e pode cadastrar novos pelo modal
  // de leads.
  interests            String[] @default(["Corte", "Coloração", "Progressiva", "Manicure"])
  // Quanto tempo cada serviço ocupa na agenda, em minutos: { "Corte": 45 }.
  // Serviço sem duração usa botSlotMinutes.
  serviceDurations     Json     @default("{}")

  // Número conectado pelo QR Code (WhatsApp Web), ex.: 5531999999999.
  whatsappPhone String?

  // Como o bot conversa com quem escreve por conta própria:
  //   "captura": só cadastra o cliente (perguntando o nome se não souber),
  //     manda botCaptureWelcomeMessage e deixa a conversa para a equipe;
  //   "menu": boas-vindas + menu (agendar, ver, remarcar, falar com a equipe).
  botMode                  String  @default("menu")
  botCaptureWelcomeMessage String  @default("Olá, {nome}! Seja bem-vinda ao nosso espaço. Em breve nosso time vai entrar em contato com você.")
  botAskNameMessage        String  @default("Olá! Seja bem-vinda ao nosso espaço. Para começarmos, qual é o seu nome?")

  // Configuração do chatbot do WhatsApp. As mensagens aceitam os marcadores
  // {nome}, {servico}, {data} e {hora}. botWorkDays usa 0 = domingo ... 6 = sábado.
  botEnabled             Boolean @default(true)
  // Quem o bot atende: "todos" (responde qualquer mensagem) ou "selecionados"
  // (só conversa com quem ele procurou: retorno automático e lembretes).
  botAudience            String  @default("todos")
  botSchedulingEnabled   Boolean @default(true)
  // Opções do menu principal, na ordem em que aparecem: agendar, ver
  // (meu agendamento), remarcar (remarcar ou cancelar), equipe.
  botMenuOptions         String[] @default(["agendar", "ver", "remarcar", "equipe"])
  botHandoffMessage      String  @default("Certo! Uma pessoa da nossa equipe vai te responder por aqui em instantes.")
  botConfirmationMessage String  @default("Agendado! {servico} no dia {data} às {hora}. Até lá, {nome}!")
  botOpeningTime         String  @default("09:00")
  botClosingTime         String  @default("19:00")
  botWorkDays            Int[]   @default([1, 2, 3, 4, 5, 6])
  // Agenda oferecida pelo bot: horários de botSlotMinutes em botSlotMinutes a
  // partir da abertura, com até botSlotCapacity atendimentos no mesmo horário.
  // Cada agendamento ocupa a duração dos seus serviços (serviceDurations).
  botSlotMinutes         Int     @default(60)
  botSlotCapacity        Int     @default(1)
  // Intervalo de almoço: nenhum atendimento pode cair dentro dele.
  botLunchEnabled        Boolean @default(false)
  botLunchStart          String  @default("12:00")
  botLunchEnd            String  @default("13:00")
  // Lembrete na véspera, enviado a partir de botReminderTime.
  botReminderEnabled     Boolean @default(true)
  botReminderTime        String  @default("10:00")
  botReminderMessage     String  @default("Oi, {nome}! Passando para lembrar do seu horário amanhã: {servico} no dia {data} às {hora}. Está tudo certo?")
  // Aviso botHourReminderMinutes antes do horário (o único, se o horário foi
  // marcado no mesmo dia).
  botHourReminderEnabled Boolean @default(true)
  botHourReminderMinutes Int     @default(60)
  botHourReminderMessage String  @default("Oi, {nome}! Seu horário é hoje às {hora}: {servico}. Te esperamos!")
  // Quando a equipe responde (CRM ou celular), o bot fica em silêncio com o
  // cliente. Se a equipe passar botHumanTimeoutMinutes sem mandar outra
  // mensagem, o bot encerra o atendimento com botHumanEndMessage + menu.
  botPauseOnStaffReply    Boolean @default(true)
  botHumanTimeoutMinutes  Int     @default(10)
  botHumanEndMessage      String  @default("Seu atendimento com a nossa equipe foi encerrado. Obrigado pelo contato!")
  // Retorno automático: mensagem para quem a equipe marcou como "Não fechou"
  // depois de botFollowUpNotClosedDays e para clientes antigos sem contato há
  // botFollowUpInactiveDays. Enviado nos dias e horários de atendimento, no
  // máximo botFollowUpDailyLimit por dia (evita bloqueio do número).
  botFollowUpNotClosedEnabled Boolean @default(false)
  botFollowUpNotClosedDays    Int     @default(15)
  botFollowUpNotClosedMessage String  @default("Oi, {nome}! Tudo bem? Passando para saber se você ainda quer agendar um horário com a gente.")
  botFollowUpInactiveEnabled  Boolean @default(false)
  botFollowUpInactiveDays     Int     @default(25)
  botFollowUpInactiveMessage  String  @default("Oi, {nome}! Sentimos sua falta por aqui. Que tal agendar um horário?")
  botFollowUpDailyLimit       Int     @default(30)
  // Retorno para quem chegou pelo WhatsApp e ainda não agendou: a primeira
  // mensagem botFollowUpLeadFirstDays dias depois do primeiro contato, depois
  // uma a cada botFollowUpLeadRepeatDays dias, até o cliente agendar. Os
  // prazos recomeçam quando o cliente manda mensagem.
  botFollowUpLeadEnabled       Boolean @default(false)
  botFollowUpLeadFirstDays     Int     @default(7)
  botFollowUpLeadFirstMessage  String  @default("Olá, {nome}! Tudo bem? Estamos passando para retomar aquele assunto do seu agendamento. Estamos com várias condições especiais. Vamos agendar o seu horário?")
  botFollowUpLeadRepeatDays    Int     @default(30)
  botFollowUpLeadRepeatMessage String  @default("Olá, {nome}! Tudo bem? Estamos com várias condições especiais neste mês. Vamos agendar o seu horário?")
  // Tela "Situação dos clientes": frequente = situationFrequentVisits
  // atendimentos nos últimos situationFrequentMonths meses; sem contato =
  // situationInactiveDays dias sem mensagem nem atendimento.
  situationFrequentVisits Int @default(3)
  situationFrequentMonths Int @default(6)
  situationInactiveDays   Int @default(30)
  // Salva nome e número do cliente nos contatos do WhatsApp do salão.
  saveContactOnWhatsApp  Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// Estado da conversa em andamento com um número de WhatsApp (menu, etapas do
// agendamento ou HUMAN = atendente assumiu e o bot fica em silêncio). Uma
// linha por número por empresa; é apagada quando o fluxo termina ou expira.
model WhatsAppSession {
  id        String   @id @default(uuid())
  companyId String
  phone     String
  step      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, phone])
  @@map("whatsapp_sessions")
}

// Nome com que o contato está salvo na agenda do celular conectado. Chega
// pela sincronização do WhatsApp (não vem junto com as mensagens), então fica
// guardado aqui. contactId segue o formato de Lead.whatsappId: só dígitos, ou
// o JID anônimo (@lid) quando o número não é conhecido.
model WhatsAppContact {
  companyId String
  contactId String
  name      String
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, contactId])
  @@map("whatsapp_contacts")
}

// Sessão do WhatsApp Web (Baileys) de cada empresa: credenciais do aparelho
// conectado e chaves de criptografia do Signal. Criptografado com lib/crypto.ts
// — quem tiver esses dados consegue usar o WhatsApp da empresa.
model WhatsAppAuth {
  companyId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
  @@map("whatsapp_auth")
}
